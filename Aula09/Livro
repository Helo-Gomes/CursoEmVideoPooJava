package Aula09;

public class Livro {
    private String nomeLivro;
    private String autorLivro;
    private int totPaginas;
    private int pagAtual;
    private boolean aberto;
    private String leitor;

    //construtor
    public Livro(String nomeLivro, int totPaginas, int pagAtual, boolean aberto) {
        this.nomeLivro = nomeLivro;
        this.totPaginas = totPaginas;
        this.pagAtual = pagAtual;
        this.aberto = aberto;
    }

    //metodos publicos
    public void detalhes(){
        System.out.println("--------- Detalhes ----------");
        System.out.println("Titulo: "+getNomeLivro());
        System.out.println("Autor: "+getAutorLivro());
        System.out.println("Total de páginas: "+getTotPaginas());
        System.out.println("Página atual: "+getPagAtual());
        System.out.println("Está aberto: "+isAberto(true));
        System.out.println("Leitor: "+getLeitor());
    }

    //metodos especiais

    public String getNomeLivro() {
        return nomeLivro;
    }

    public void setNomeLivro(String nomeLivro) {
        this.nomeLivro = nomeLivro;
    }

    public String getAutorLivro() {
        return autorLivro;
    }

    public void setAutorLivro(String autorLivro) {
        this.autorLivro = autorLivro;
    }

    public int getTotPaginas() {
        return totPaginas;
    }

    public void setTotPaginas(int totPaginas) {
        this.totPaginas = totPaginas;
    }

    public int getPagAtual() {
        return pagAtual;
    }

    public void setPagAtual(int pagAtual) {
        this.pagAtual = pagAtual;
    }

    public boolean isAberto(boolean b) {
        return aberto;
    }

    public void setAberto(boolean aberto) {
        this.aberto = aberto;
    }

    public String getLeitor() {
        return leitor;
    }

    public void setLeitor(String leitor) {
        this.leitor = leitor;
    }

    public void abrir() {
        this.aberto = true;
        System.out.println("Livro aberto");
    }

    public void fechar() {
        this.aberto = false;
        System.out.println("Livro fechado");

    }

    public void folhear() {
        System.out.println("Passando pelas páginas.");
    }

    public void avancarPag() {
        this.pagAtual += 1;
        System.out.println("Página: "+this.pagAtual);
    }

    void voltarPag() {
        this.pagAtual -= 1;
        System.out.println("Página: "+this.pagAtual);
    }
}
